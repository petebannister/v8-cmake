Subject: [PATCH] Use a generic callable for backing store GC retries
---
diff --git a/v8/src/objects/backing-store.cc b/v8/src/objects/backing-store.cc
--- a/v8/src/objects/backing-store.cc
+++ b/v8/src/objects/backing-store.cc
@@ -323,7 +323,7 @@
   // For accounting purposes, whether a GC was necessary.
   bool did_retry = false;
 
-  auto gc_retry = [&](const std::function<bool()>& fn) {
+  auto gc_retry = [&](const auto& fn) {
     if (fn()) return true;
     // Collect garbage and retry.
     did_retry = true;
